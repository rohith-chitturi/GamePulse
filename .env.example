# ==============================================================================
# GamePulse — Environment Configuration Template (.env.example)
# Copy this file to .env and configure secrets appropriately for your environment.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Application & Active Spring Profile
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod
GAMEPULSE_CHAOS_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL Configuration
POSTGRES_DB=gamepulsedb
POSTGRES_USER=gamepulse
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5433

# Database Connection Pool (HikariCP)
HIKARI_MAX_POOL_SIZE=25
HIKARI_MIN_IDLE=10

# Redis Distributed Cache Configuration
REDIS_PORT=6381
REDIS_PASSWORD=

# Observability (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
